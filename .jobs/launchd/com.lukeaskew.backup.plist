<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lukeaskew.backup</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.jobs/bin/backup.sh</string>
	</array>

	<!-- Every Tuesday at 12:00. If asleep at the scheduled time, launchd runs it on next wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>2</integer>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/backup.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/backup.log</string>
</dict>
</plist>
